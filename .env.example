# ============================
# Odyssey v2 — Environment Variables
# Copy this file to .env and fill in your values
########################################
# FYERS API CONFIGURATION (Indian Markets)
########################################
FYERS_API_KEY=your_fyers_api_key
FYERS_SECRET_KEY=your_fyers_secret_key
FYERS_REDIRECT_URI=http://localhost:8080/
FYERS_ACCESS_TOKEN=your_generated_access_token

########################################
# TELEGRAM ALERTING (Optional)
########################################
TELEGRAM_BOT_TOKEN=your_bot_father_token
TELEGRAM_CHAT_ID=your_chat_id

# --- QuestDB ---
QUESTDB_HOST=localhost
QUESTDB_PORT=8812
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest
QUESTDB_DATABASE=qdb

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

